<?xml version="1.0" encoding="utf-8"?>
<Activity mc:Ignorable="sap sap2010 sads" x:Class="GetSAPCredentials" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Sequence DisplayName="GetSAPCredentials">
    <ui:TryCatch DisplayName="Get Credentials Try Catch">
      <ui:TryCatch.Try>
        <Sequence>
          <ui:GetCredential DisplayName="Get Credential SAP-Loggin" AssetName="SAP-Loggin" Result="credentialResult" />
          <ui:Assign DisplayName="Set strUsuarioSAP" To="strUsuarioSAP" Value="credentialResult.UserName" />
          <ui:Assign DisplayName="Set securePasswordSAP" To="securePasswordSAP" Value="credentialResult.Password" />
          <ui:LogMessage DisplayName="Credenciales obtenidas" Level="Info" Message="[INFO] Credenciales obtenidas desde Asset SAP-Loggin" />
        </Sequence>
      </ui:TryCatch.Try>
      <ui:TryCatch.Catches>
        <ui:Catch x:TypeArguments="System.Exception">
          <ui:Throw DisplayName="Throw Asset Error" Exception="New System.Exception(&quot;Asset SAP-Loggin no encontrado o no accesible.&quot;)" />
        </ui:Catch>
      </ui:TryCatch.Catches>
    </ui:TryCatch>
  </Sequence>
</Activity>
